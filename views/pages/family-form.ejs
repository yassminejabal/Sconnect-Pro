<%- include('../partials/header') %>

<main class="container">
  <div style="max-width: 600px; margin: 0 auto;">
    <h2 style="margin-bottom: 1.5rem; font-size: 1.8rem;">Ajouter un Foyer Fiscal</h2>

    <% if (error) { %>
      <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/families" method="POST" class="card" style="gap: 1.2rem;">
      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Nom du foyer / famille :</label>
        <input type="text" name="name" required placeholder="Ex: Famille Benali" style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: white;">
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Quotient Familial (€) :</label>
        <input type="number" step="0.01" name="quotient_familial" required placeholder="Ex: 550.00" style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: white;">
        <small style="color: var(--text-muted); font-size: 0.8rem;">Moins de 600€ = -40% | Entre 600€ et 900€ = -20%</small>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Adresse de résidence :</label>
        <input type="text" name="address" placeholder="Ex: 12 Rue des Fleurs, Quartier Al Amal" style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: white;">
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem;">
        <input type="checkbox" name="is_resident" id="is_resident" value="true" checked style="width: 18px; height: 18px;">
        <label for="is_resident" style="color: var(--text-main); font-size: 0.95rem;">Résident communal (Bénéficie du tarif sans majoration de 35%)</label>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1rem;">
        <button type="submit" class="btn" style="flex: 1; cursor: pointer;">Enregistrer le foyer</button>
        <a href="/families" class="btn" style="background: transparent;">Annuler</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>